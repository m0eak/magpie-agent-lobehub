{
  "name": "magpie-agent-lobehub",
  "version": "0.2.1",
  "description": "Magpie agent plugin that names LobeHub's requests (User-Agent: lobehub/...) in Usage and draws them with the LobeHub icon. Recognition and icon only: it writes nothing.",
  "license": "MIT",
  "author": "m0eak",
  "type": "module",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-agent",
    "lobehub",
    "user-agent"
  ],
  "files": [
    "agent.js",
    "assets/icon.svg",
    "scripts/arrange-client.mjs",
    "selfcheck.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node selfcheck.mjs",
    "arrange": "node scripts/arrange-client.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "magpie": {
    "agent": "./agent.js"
  }
}
